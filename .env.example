# LogMorph Environment Variables Example
# Copy this file to .env and replace with your actual secrets

# Environment (development, testing, production)
ENVIRONMENT=development

# Database Connection
# For NeonDB: postgresql+asyncpg://user:password@ep-cool-db.region.aws.neon.tech/dbname?ssl=require
# For Local Dev: sqlite+aiosqlite:///./logmorph_dev.db
DATABASE_URL=sqlite+aiosqlite:///./logmorph_dev.db

# Security (Run `openssl rand -hex 32` to generate a secure key)
SECRET_KEY=super_secret_key_for_development_only

# NVIDIA NIM (Free AI Fallback Parsing)
NVIDIA_NIM_API_KEY=nvapi-your-key-here

# Apache Kafka (Serverless Upstash Kafka or Local Kafka)
# For local dev: localhost:9092
# For Upstash Kafka: joyful-donkey-12345-us1-kafka.upstash.io:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_RAW_LOGS=raw-logs
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN

# Upstash Redis (For Deduplication and Caching)
# Example: rediss://default:password@eu1-upstash-redis.upstash.io:30000
REDIS_URL=redis://localhost:6379/0
